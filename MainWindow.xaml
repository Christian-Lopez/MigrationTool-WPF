<Window x:Class="MigrationTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Migration Tool" 
        Height="700" 
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navigation Menu -->
        <Border Grid.Row="0" 
                Background="White" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SQL Migration Tool" 
                              FontSize="20" 
                              FontWeight="SemiBold"
                              Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock x:Name="VersionText"
                              Text="v1.0.0" 
                              FontSize="14" 
                              FontWeight="Normal" 
                              Foreground="#9CA3AF"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button x:Name="ConnectionsButton" 
                            Content="Connections" 
                            Margin="5,0"
                            Padding="15,8"
                            Click="NavigateToConnections_Click"/>
                    <Button x:Name="DataMigrationButton" 
                            Content="Data Migration" 
                            Margin="5,0"
                            Padding="15,8"
                            Click="NavigateToDataMigration_Click"/>
                    <Button x:Name="MigrationsButton" 
                            Content="Migrations" 
                            Margin="5,0"
                            Padding="15,8"
                            Click="NavigateToMigrations_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Frame -->
        <Frame x:Name="ContentFrame" 
               Grid.Row="1" 
               NavigationUIVisibility="Hidden"
               Background="{StaticResource BackgroundBrush}"/>
    </Grid>
</Window>
