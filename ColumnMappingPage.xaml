<Page x:Class="MigrationTool.ColumnMappingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:MigrationTool"
      Title="Column Mapping"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="White" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Column Mapping Configuration" 
                          FontSize="24" 
                          FontWeight="SemiBold"
                          Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock x:Name="TableNameText"
                          Text="Table: [Schema].[TableName]" 
                          FontSize="14" 
                          Foreground="#6B7280"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>


        <Border Grid.Row="2"
                x:Name="SummaryBorder"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="SummaryText"
                          Text="Mapping Summary"
                          FontSize="13"
                          Foreground="#1E40AF"
                          TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Mapping Grid -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <DataGrid x:Name="MappingGrid"
                     ItemsSource="{Binding Mappings}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     CanUserReorderColumns="False"
                     CanUserSortColumns="True"
                     HeadersVisibility="Column"
                     GridLinesVisibility="Horizontal"
                     BorderThickness="0"
                     RowHeight="40"
                     SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Source Column -->
                    <DataGridTextColumn Header="Source Column" 
                                       Binding="{Binding SourceColumn.DisplayName}"
                                       Width="2*"
                                       IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Arrow -->
                    <DataGridTextColumn Header="" 
                                       Width="50"
                                       IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="→"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Destination Column (ComboBox) -->
                    <DataGridTemplateColumn Header="Destination Column" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="DestColumnCombo"
                                         ItemsSource="{Binding DataContext.DestinationColumns, RelativeSource={RelativeSource AncestorType=Page}}"
                                         SelectedItem="{Binding DestinationColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         DisplayMemberPath="DisplayName"
                                         Margin="5"
                                         SelectionChanged="DestColumnCombo_SelectionChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTextColumn Header="Status" 
                                       Binding="{Binding StatusDisplay}"
                                       Width="*"
                                       IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Validation Messages -->
        <Border Grid.Row="4"
                x:Name="ValidationBorder"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,15,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="⚠ Validation Issues" 
                          FontWeight="SemiBold"
                          Foreground="#991B1B"
                          Margin="0,0,0,5"/>
                <TextBlock x:Name="ValidationText"
                          Text=""
                          FontSize="12"
                          Foreground="#7F1D1D"
                          TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="5"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Auto-Map" 
                           Click="AutoMap_Click"
                           Padding="15,8"
                           Margin="0,0,10,0"/>
                    <Button Content="Clear All" 
                           Click="ClearAll_Click"
                           Padding="15,8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Save Mapping" 
                           Click="SaveMapping_Click"
                           Padding="20,8"
                           Margin="0,0,10,0"
                           Background="{StaticResource PrimaryBrush}"
                           Foreground="White"
                           BorderThickness="0"/>
                    <Button Content="Cancel" 
                           Click="Cancel_Click"
                           Padding="15,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
